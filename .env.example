# Copy to .env. Do not commit real keys. Empty ALLOWED_USER_IDS permits all users.
DB_URL=jdbc:postgresql://localhost:5432/video_audio_bot
DB_USER=video_audio_bot
DB_PASSWORD=replace-me
DB_POOL_SIZE=16
DB_CONNECTION_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT=30s
SERVER_PORT=8080
LOG_LEVEL=INFO
WORK_DIRECTORY=./work
TELEGRAM_BOT_TOKEN=
TELEGRAM_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOCAL_DIRECTORY=/var/lib/telegram-bot-api
TELEGRAM_SERVER_DIRECTORY=/var/lib/telegram-bot-api
TELEGRAM_REQUEST_TIMEOUT=10m
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_MAX_FILE_BYTES=2147483648
TELEGRAM_ALLOWED_USER_IDS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TIMEOUT=30m
OPENAI_MAX_UPLOAD_BYTES=24000000
OPENAI_MAX_SPEAKER_REFERENCES=4
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
S3_PREFIX=video-audio-bot/
S3_TIMEOUT=15m
S3_LINK_TTL=24h
S3_PURGE_VERSIONS=false
PIPELINE_ENABLED=true
PIPELINE_POLL_INTERVAL=2s
PIPELINE_LEASE_DURATION=90s
PIPELINE_HEARTBEAT_INTERVAL=20s
PIPELINE_MAX_ATTEMPTS=5
PIPELINE_RETRY_BASE=10s
PIPELINE_RETRY_MAX=15m
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_TIMEOUT=2h
AUDIO_BITRATE_KBPS=64
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SECONDS=1200
AUDIO_OVERLAP_SECONDS=2
MEDIA_MAX_DURATION_SECONDS=43200
CLEANUP_ENABLED=true
CLEANUP_INTERVAL=10m
RETENTION=24h
CLEANUP_BATCH_SIZE=50
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DB_NAME=video_audio_bot
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
LOCAL_BOT_CONTEXT=../local-server-telegram-bot
LOCAL_BOT_BUILD_JOBS=2
TELEGRAM_VERBOSITY=1
TELEGRAM_BOT_API_REF=e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1
APP_STOP_GRACE_PERIOD=45s
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
HTTP_CONNECT_TIMEOUT=15s
APP_IMAGE=video-audio-bot:local
LOCAL_BOT_IMAGE=local-server-telegram-bot:local
POSTGRES_IMAGE=postgres:17-bookworm
TELEGRAM_FILE_SERVER_URL=
TELEGRAM_FILE_SERVER_TOKEN=
